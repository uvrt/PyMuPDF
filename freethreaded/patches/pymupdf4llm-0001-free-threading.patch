+class _ThreadMessages:
+    """A file-like object holding a separate io.StringIO per thread, so that
+    documents parsed concurrently don't mix their messages."""
+
+    def __init__(self):
+        self._local = threading.local()
+
+    def _buffer(self):
+        buf = getattr(self._local, "buffer", None)
+        if buf is None:
+            buf = self._local.buffer = io.StringIO()
+        return buf
+
+    def write(self, text):
+        return self._buffer().write(text)
+
+    def flush(self):
+        pass
+
+    def getvalue(self):
+        return self._buffer().getvalue()
+
+    def clear(self):
+        self._local.buffer = io.StringIO()
+
+
