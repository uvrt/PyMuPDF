+import os
+import threading
+
 import pymupdf
 
 
+def _per_thread():
+    """One model per thread on free-threaded Python, unless PYMUPDF_LAYOUT_PER_THREAD=0."""
+    if not getattr(pymupdf, "_free_threaded", False):
+        return False
+    return os.environ.get("PYMUPDF_LAYOUT_PER_THREAD", "1") != "0"
+
+
 def activate():
-    """Create a layout analyzer function using an ONNX model."""
+    """Create a layout analyzer function using an ONNX model.
+
+    A model's predict() keeps per-page state on the model, so a shared model
+    must be serialised. On free-threaded Python each thread gets its own model
+    instead (about 20 MB of ONNX sessions per thread), created on first use,
+    and pymupdf._get_layout_per_thread tells callers not to serialise. Models
+    made on worker threads use PYMUPDF_LAYOUT_ORT_THREADS (default 1)
+    onnxruntime threads per session.
+    """
     if callable(pymupdf._get_layout):
         return  # already activated
+    per_thread = _per_thread()
+    ort_threads = int(os.environ.get("PYMUPDF_LAYOUT_ORT_THREADS", "1"))
+    if per_thread and threading.current_thread() is not threading.main_thread():
+        # pymupdf4llm imports us lazily, possibly on a worker thread; that
+        # thread's model must not get onnxruntime's default thread pools.
+        _onnx_common_util.session_settings.intra_op_threads = ort_threads
     MODEL = DocumentLayoutAnalyzer.get_model()
 
-    def _get_layout(*args, **kwargs):
-        return MODEL.predict(*args, **kwargs)
+    if per_thread:
+        local = threading.local()
+        local.model = MODEL
+
+        def _get_layout(*args, **kwargs):
+            model = getattr(local, "model", None)
+            if model is None:
+                # Worker threads run in parallel with each other, so their
+                # sessions get few threads (a main-thread model keeps
+                # onnxruntime's defaults). Set for this thread only and left
+                # set, so sessions the model creates later get it too.
+                _onnx_common_util.session_settings.intra_op_threads = ort_threads
+                model = local.model = DocumentLayoutAnalyzer.get_model()
+            return model.predict(*args, **kwargs)
+
+        pymupdf._get_layout_per_thread = True
+    else:
+        def _get_layout(*args, **kwargs):
+            return MODEL.predict(*args, **kwargs)
 
     pymupdf._get_layout = _get_layout
 
